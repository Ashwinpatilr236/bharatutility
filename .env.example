# ==============================================================================
# BharatUtility - Environment Configuration Template
# Copy this file to .env or .env.local and populate the values for your setup.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Application URL (used for canonical links, sitemaps, and metadata)
# Example: https://bharatutility.tech or http://localhost:3000
APP_URL="https://bharatutility.tech"

# Server Port (used by server.ts, defaults to 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV="development"

# Supabase Public Integration (Remote Database, Feedback, Tool Requests)
# Obtain these from your Supabase Project Settings -> API
# Note: Client-side code requires the public/anon key only. NEVER expose service-role keys here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key-here"

# (Optional) Supabase Service Role Key
# ONLY required for running offline batch maintenance scripts (e.g. scripts/importIndiaPostOffices.ts).
# NEVER expose this key in client-side code or browser bundles.
# SUPABASE_SERVICE_ROLE_KEY=""

# (Optional) Vite Development Options
# Set to 'true' to disable Hot Module Replacement in certain containerized or CI environments
# DISABLE_HMR="false"
